{
  "name": "mi-connect",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "db:migrate": "tsx --conditions=react-server scripts/manage.ts migrate",
    "db:seed:demo": "tsx --conditions=react-server scripts/manage.ts seed",
    "data:import": "tsx --conditions=react-server scripts/manage.ts import",
    "data:index": "tsx --conditions=react-server scripts/manage.ts index",
    "doctor": "tsx --conditions=react-server scripts/manage.ts doctor",
    "format": "prettier --write src scripts tests *.ts *.mjs package.json",
    "data:collect": "node scripts/collect-rops.mjs",
    "data:validate": "tsx --conditions=react-server scripts/manage.ts validate-corpus",
    "data:sync": "tsx --conditions=react-server scripts/manage.ts sync-corpus"
  },
  "dependencies": {
    "dotenv": "18.0.5",
    "drizzle-orm": "0.45.3",
    "iron-session": "9.0.1",
    "next": "16.3.8",
    "openai": "7.27.0",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cheerio": "1.2.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
